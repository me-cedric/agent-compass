{
  "name": "agent-compass",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Central agentic standards, guidelines, skills and bootstrap tooling for AI coding agents (Claude, Codex, Copilot).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "cli": "node scripts/cli.mjs",
    "bootstrap": "node scripts/bootstrap.mjs",
    "context": "node scripts/context.mjs",
    "agent-conformance": "node scripts/agent-conformance.mjs",
    "agent-evals": "node scripts/agent-evals.mjs",
    "agent-drift": "node scripts/agent-drift.mjs",
    "agent-trace": "node scripts/agent-trace.mjs",
    "agent-onboard": "node scripts/agent-onboard.mjs",
    "context-pack": "node scripts/context-pack.mjs",
    "run-command": "node scripts/run-command.mjs",
    "new": "node scripts/new.mjs",
    "check-companions": "node scripts/check-change-companions.mjs",
    "redact": "node scripts/redact.mjs",
    "trace-to-evals": "node scripts/trace-to-evals.mjs",
    "gen-depgraph": "node scripts/gen-depgraph.mjs",
    "doctor-report": "node scripts/doctor-report.mjs",
    "pull-knowledge": "node scripts/pull-knowledge.mjs",
    "pr": "node scripts/pr.mjs",
    "pr-review": "node scripts/pr-review.mjs",
    "release": "node scripts/release.mjs",
    "runbook": "node scripts/runbook.mjs",
    "upgrade-host": "node scripts/upgrade-host.mjs",
    "install-into": "node scripts/install.mjs",
    "sync-into": "node scripts/sync.mjs",
    "check-update": "node scripts/check-update.mjs",
    "test": "node --test",
    "check": "npm test && npm run agent-conformance -- --strict && npm run agent-evals && npm run lint:actions && npm run lint:naming && npm run lint:indexes && npm run lint:docs",
    "lint:actions": "node scripts/check-actions.mjs",
    "lint:naming": "node scripts/check-naming.mjs",
    "lint:indexes": "node scripts/check-indexes.mjs",
    "lint:docs": "node scripts/check-docs.mjs",
    "lint:release": "node scripts/check-release.mjs"
  },
  "bin": {
    "agent-compass": "scripts/cli.mjs"
  },
  "license": "SEE LICENSE IN LICENSE"
}
