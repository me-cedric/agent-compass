{
  "name": "agent-compass",
  "version": "0.9.6",
  "private": true,
  "type": "module",
  "description": "Shared operating kit for AI coding agents (Claude Code, Codex, GitHub Copilot) in team repositories.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "evidence": "node scripts/evidence.mjs",
    "run-command": "node scripts/run-command.mjs",
    "check-companions": "node scripts/check-change-companions.mjs",
    "redact": "node scripts/redact.mjs",
    "test": "node --test",
    "check": "npm test && npm run lint:actions && npm run lint:naming && npm run lint:docs",
    "lint:actions": "node scripts/check-actions.mjs",
    "lint:naming": "node scripts/check-naming.mjs",
    "lint:docs": "node scripts/check-docs.mjs"
  },
  "license": "MIT"
}
