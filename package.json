    "vendor-into": "node scripts/vendor.mjs",
    "check-update": "node scripts/check-update.mjs",
    "test": "node --test",
    "check": "npm test && npm run agent-conformance -- --strict && npm run agent-evals && npm run lint:actions && npm run lint:naming && npm run lint:indexes && npm run lint:docs && npm run lint:skill-quality && npm run lint:skill-docs",
