# Build stage
FROM --platform=$BUILDPLATFORM node:22-alpine AS builder

# Install pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /usr/src/app

# Copy pnpm lock and workspace files
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./

# Copy workspace package files
COPY apps/backoffice/package.json ./apps/backoffice/
COPY packages ./packages

# Install all dependencies (monorepo)
RUN pnpm install --frozen-lockfile --ignore-scripts && pnpm store prune

# Copy backoffice source code
COPY apps/backoffice ./apps/backoffice

# Copy config
COPY turbo.json* ./
COPY tsconfig.base.json ./

# Build the backoffice application
ENV NODE_ENV=production
ARG VITE_APP_VERSION
ENV VITE_APP_VERSION=$VITE_APP_VERSION
ARG VITE_APP_BUILD_NUMBER=0
ENV VITE_APP_BUILD_NUMBER=$VITE_APP_BUILD_NUMBER
RUN pnpm build --filter @scope/backoffice

# Production stage
FROM nginx:alpine

# Copy nginx configuration
COPY apps/backoffice/nginx.conf /etc/nginx/conf.d/default.conf

# Copy built files from builder stage
COPY --from=builder /usr/src/app/apps/backoffice/dist /usr/share/nginx/html

# Copy entrypoint script
COPY apps/backoffice/docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

# Expose port 80
EXPOSE 80

# Use entrypoint to generate runtime config
ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["nginx", "-g", "daemon off;"]
